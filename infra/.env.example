# infra/.env로 복사해서 쓴다(.env는 git에 올리지 않는다). 로컬 개발용 값이다.
POSTGRES_DB=storesearch
POSTGRES_USER=storesearch
# 로컬 전용 비밀번호. 아무 값이나 정해서 넣는다(서버 비밀번호와 같게 쓰지 않는다)
POSTGRES_PASSWORD=
DB_PORT=5432
DB_SHARED_BUFFERS=2GB

# 임베딩 모델 폴더(bge_m3_ft_mj_20261014_0743, Drive store-search-ai/runs/finetune/에서 폴더째). 사람마다 위치가 달라 여기에 적는다.
# 비우면 저장소의 models/bge_m3_ft_mj_20261014_0743(git 제외)을 쓴다. Windows도 / 로 적는다(예: C:/Users/me/Downloads/bge_m3_ft_mj_20261014_0743)
EMBEDDING_MODEL_DIR=
EMBEDDING_PORT=8001
# API 서버가 임베딩 서버를 부르는 주소. localhost 대신 127.0.0.1(Windows에서 localhost는 IPv6를 먼저 시도해 1~2초 늦어짐)
EMBEDDING_URL=http://127.0.0.1:8001

